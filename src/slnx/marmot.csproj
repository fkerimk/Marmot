<Project>

    <PropertyGroup>
        <OutPath>.sln/marmot</OutPath>
        <OutputPath>$(OutPath)/Debug</OutputPath>
        <PublishDir>$(OutPath)/build</PublishDir>
        <RestoreOutputPath>$(OutPath)</RestoreOutputPath>
        <BaseIntermediateOutputPath>$(OutPath)</BaseIntermediateOutputPath>
        <MSBuildProjectExtensionsPath>$(OutPath)</MSBuildProjectExtensionsPath>
    </PropertyGroup>

    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <Version>0.0.1</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="8.0.0" />
        <PackageReference Include="rlImgui-cs" Version="3.2.0" />
        <ProjectReference Include="gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <Compile Include="../marmot/**/*.cs" Link="marmot/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="CopyBuild" AfterTargets="Publish">
        <ItemGroup>
            <BuildFiles Include=".sln/marmot/build/marmot.dll;.sln/marmot/build/Raylib-cs.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(BuildFiles)" DestinationFolder="../../build/lib" />
    </Target>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
